# VWorld(브이월드) 오픈API 인증키 — https://www.vworld.kr 인증키 발급
EXPO_PUBLIC_VWORLD_KEY=
# 인증키 발급 시 등록한 서비스 URL (WMS의 domain 파라미터, Referer 헤더에 사용)
EXPO_PUBLIC_VWORLD_DOMAIN=
# 백엔드 주소 (없으면 iOS 시뮬레이터 http://localhost:8000, 안드로이드 에뮬레이터 http://10.0.2.2:8000)
# 실제 폰은 같은 와이파이의 PC IP. 예: http://192.168.0.10:8000
EXPO_PUBLIC_API_BASE=
