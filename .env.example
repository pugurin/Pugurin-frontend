# sample: 화면 확인용 가짜 데이터 / api: 실제 백엔드 API 사용 (샘플 자동 대체 없음)
EXPO_PUBLIC_DATA_MODE=api
# 웹에서는 아래 로컬 개발 프록시 사용: npm run api:dev
# 휴대폰 실기기는 localhost 대신 개발 PC의 LAN IP를 사용하세요.
EXPO_PUBLIC_API_URL=
# sample: 앱 안 가짜 인증 서버로 로그인·회원가입 화면을 켠다(화면 확인용)
# api: 실제 백엔드 로그인(웹만. 앱은 소셜 SDK 전이라 준비 중). 백엔드가 https이고 로그인 키가 들어간 뒤에 켠다
# 비워 두면 로그인 카드는 "준비 중"으로 보인다
EXPO_PUBLIC_AUTH_MODE=
# 웹 소셜 로그인 공개 클라이언트 ID(비밀값 아님, AUTH_MODE=api일 때). 비운 제공자는 "준비 중"으로 알린다
# 각 콘솔에 Redirect URI로 <웹 주소>/auth/callback 을 등록하고, 백엔드 PUGURIN_AUTH_REDIRECT_URIS에도 똑같이 넣는다
# 카카오는 REST API 키가 client_id다(백엔드 PUGURIN_KAKAO_REST_KEY와 같은 값)
EXPO_PUBLIC_KAKAO_REST_KEY=
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# 카카오맵 JavaScript 키 (필수). 비워 두면 지도 대신 키 설정 안내가 뜬다.
# 앱에 포함되는 키이므로 카카오 개발자 콘솔에서 JavaScript SDK 도메인을 제한한다 (예: http://localhost:8081, 배포 주소)
EXPO_PUBLIC_KAKAO_JS_KEY=
# 앱(WebView)의 문서 주소. JavaScript SDK 도메인에 등록한 https 주소를 넣는다 (예: 배포 웹 주소)
EXPO_PUBLIC_KAKAO_APP_URL=
# 실제 약관/개인정보 원문 URL이 준비되면 입력
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_LOCATION_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_CONTACT_EMAIL=

# 대중교통 길찾기(출퇴근). 백엔드 /transit/routes가 준비되면 on. 샘플 데이터 모드에서는 늘 켜진다
EXPO_PUBLIC_TRANSIT=
